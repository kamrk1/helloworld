# Local default: SQLite on this machine. No cloud credentials required.
# The file is created next to prisma/schema.prisma (prisma/clinic.db).
DATABASE_URL="file:./clinic.db"

# Production / PWA: hosted Postgres is the live source of truth.
# Phone and desktop both talk to this URL. Instant Prisma DB: npx create-db@latest
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Required to log in at /login (migrated onto clinic `sdc` as passwordDigest)
ADMIN_PASSWORD="changeme"

# Platform operator console at /platform (demo default is platform-demo if unset)
PLATFORM_PASSWORD="platform-demo"

# Compatibility shims: / and /admin without a slug go to this clinic
DEFAULT_CLINIC_ID="sdc"

# Signed httpOnly session cookie. Use a long random string in production.
SESSION_SECRET="dev-session-secret-change-me"

# Optional public review link — copied onto clinic `sdc` on first boot if the row has no review URL
NEXT_PUBLIC_REVIEW_URL=""

# Optional clinic contact — copied onto clinic `sdc` on first boot if empty
NEXT_PUBLIC_CLINIC_PHONE="9876543210"
NEXT_PUBLIC_CLINIC_ADDRESS=""

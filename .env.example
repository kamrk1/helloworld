# SQLite database (Prisma)
DATABASE_URL="file:./clinic.db"

# Required to log in at /login
ADMIN_PASSWORD="changeme"

# Signed httpOnly session cookie. Use a long random string in production.
SESSION_SECRET="dev-session-secret-change-me"

# Optional public review link shown in admin (Google reviews, etc.)
NEXT_PUBLIC_REVIEW_URL=""

# Optional clinic contact shown on the public booking page
NEXT_PUBLIC_CLINIC_PHONE="9876543210"
NEXT_PUBLIC_CLINIC_ADDRESS=""
